---
import '../styles/global.css';
const { title = "Soumitra Rajguru — AI/ML & Software Engineering Portfolio" } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content="Portfolio of Soumitra Rajguru, Computer Engineering student at VIT Mumbai. Building intelligent systems — multi-agent research pipelines, LLM evaluation tools, and practical software." />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
		<script is:inline>
			try {
				var saved = localStorage.getItem('sr-theme');
				var preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				document.documentElement.setAttribute('data-theme', saved || preferred);
			} catch (e) {}
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body class="bg-slate-900 text-white min-h-screen">
		<a class="skip-link absolute -top-10 left-4 z-50 px-4 py-2 bg-blue-500 text-white font-semibold rounded-lg focus:top-4 transition-all" href="#main">Skip to content</a>
		<slot />
	</body>
</html>