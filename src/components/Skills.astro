---
---
<section class="section py-20 md:py-28 lg:py-32" id="skills" aria-labelledby="skills-title">
	<div class="container mx-auto px-6">
		<header class="section-head reveal mb-12 md:mb-16">
			<p class="eyebrow font-mono text-xs font-medium tracking-widest uppercase text-blue-400 mb-3">03 / Technical Skills</p>
			<h2 class="section-title text-3xl md:text-4xl lg:text-5xl font-bold max-w-[24ch]">Tools I actually use.</h2>
			<p class="section-sub mt-3 max-w-2xl text-slate-400">Grounded in coursework and shipped project code — not a wishlist.</p>
		</header>

		<div class="skills-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
			<div class="skill-group reveal bg-slate-800/50 border border-slate-700 rounded-2xl p-6 transition-colors duration-250 hover:border-slate-600">
				<h3 class="skill-group-title flex items-baseline gap-3 mb-4">
					<span class="skill-index font-mono text-sm font-medium text-blue-400">01</span>
					Programming Languages
				</h3>
				<ul class="skill-list flex flex-wrap gap-2">
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Python</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Java</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">JavaScript</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">TypeScript</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">SQL</li>
				</ul>
			</div>

			<div class="skill-group reveal bg-slate-800/50 border border-slate-700 rounded-2xl p-6 transition-colors duration-250 hover:border-slate-600">
				<h3 class="skill-group-title flex items-baseline gap-3 mb-4">
					<span class="skill-index font-mono text-sm font-medium text-blue-400">02</span>
					AI & Machine Learning
				</h3>
				<ul class="skill-list flex flex-wrap gap-2">
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">scikit-learn</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">PyTorch</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">pandas</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">NumPy</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">sentence-transformers</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">OpenCV</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">MediaPipe</li>
				</ul>
			</div>

			<div class="skill-group reveal bg-slate-800/50 border border-slate-700 rounded-2xl p-6 transition-colors duration-250 hover:border-slate-600">
				<h3 class="skill-group-title flex items-baseline gap-3 mb-4">
					<span class="skill-index font-mono text-sm font-medium text-blue-400">03</span>
					LLM Applications
				</h3>
				<ul class="skill-list flex flex-wrap gap-2">
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">LangChain</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">LangGraph</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">RAG pipelines</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Gemini API</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Groq</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Prompt-injection defense</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">LLM evaluation</li>
				</ul>
			</div>

			<div class="skill-group reveal bg-slate-800/50 border border-slate-700 rounded-2xl p-6 transition-colors duration-250 hover:border-slate-600">
				<h3 class="skill-group-title flex items-baseline gap-3 mb-4">
					<span class="skill-index font-mono text-sm font-medium text-blue-400">04</span>
					Web Development
				</h3>
				<ul class="skill-list flex flex-wrap gap-2">
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">FastAPI</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Next.js</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">React</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Tailwind CSS</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Vite</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Streamlit</li>
