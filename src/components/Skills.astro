				</ul>
			</div>

			<div class="skill-group reveal bg-slate-800/50 border border-slate-700 rounded-2xl p-6 transition-colors duration-250 hover:border-slate-600">
				<h3 class="skill-group-title flex items-baseline gap-3 mb-4">
					<span class="skill-index font-mono text-sm font-medium text-blue-400">05</span>
					Databases
				</h3>
				<ul class="skill-list flex flex-wrap gap-2">
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">SQLite</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">PostgreSQL</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Supabase</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">ChromaDB</li>
				</ul>
			</div>

			<div class="skill-group reveal bg-slate-800/50 border border-slate-700 rounded-2xl p-6 transition-colors duration-250 hover:border-slate-600">
				<h3 class="skill-group-title flex items-baseline gap-3 mb-4">
					<span class="skill-index font-mono text-sm font-medium text-blue-400">06</span>
					Developer Tools
				</h3>
				<ul class="skill-list flex flex-wrap gap-2">
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Git & GitHub</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">GitHub Actions</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Docker</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">pytest</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">uv</li>
					<li class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/50 text-sm font-medium text-slate-300 hover:border-blue-500/40 hover:text-white transition-colors">Linux CLI</li>
