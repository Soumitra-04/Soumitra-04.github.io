---
---
<section class="hero relative overflow-hidden pt-20 pb-20 md:pt-32 md:pb-32 lg:pt-40 lg:pb-40" id="top" aria-labelledby="hero-title">
	<div class="hero-grid-bg absolute inset-0 opacity-50 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(to right, rgba(148, 163, 184, 0.15) 1px, transparent 1px), linear-gradient(to bottom, rgba(148, 163, 184, 0.15) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse 90% 70% at 60% 20%, #000 25%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 90% 70% at 60% 20%, #000 25%, transparent 75%);"></div>

	<div class="container mx-auto px-6 relative">
		<div class="hero-inner grid md:grid-cols-12 gap-8 md:gap-12 items-center">
			<div class="hero-copy md:col-span-7 reveal">
				<p class="eyebrow font-mono text-xs font-medium tracking-widest uppercase text-blue-400 mb-4">B.Tech Computer Engineering / VIT Mumbai</p>

				<h1 class="hero-name text-5xl md:text-6xl lg:text-7xl font-extrabold uppercase tracking-tight leading-[1.02]" id="hero-title">Soumitra<br class="hidden md:block" />Rajguru</h1>

				<p class="hero-headline mt-4 font-mono text-lg md:text-xl font-medium text-blue-400">I build intelligent systems.</p>

				<p class="hero-intro mt-4 max-w-2xl text-slate-300 text-base md:text-lg leading-relaxed">
					Computer Engineering student working across <strong>AI/ML</strong>, <strong>software engineering</strong>,
					and <strong>research</strong> — designing multi-agent pipelines, auditing how models behave,
					and shipping practical tools for real-world problems.
				</p>

				<div class="hero-actions flex flex-wrap gap-3 mt-8">
					<a class="btn btn-primary px-5 py-3 rounded-lg font-semibold text-base" href="#projects">Explore Projects</a>
					<a class="btn btn-ghost px-5 py-3 rounded-lg font-semibold text-base border border-slate-600 hover:border-blue-400 hover:text-blue-400" href="https://github.com/Soumitra-04" target="_blank" rel="noopener noreferrer">
						GitHub
						<svg class="w-5 h-5 inline-block ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
					</a>
					<a class="btn btn-ghost px-5 py-3 rounded-lg font-semibold text-base border border-slate-600 hover:border-blue-400 hover:text-blue-400" href="#contact">Contact Me</a>
				</div>

				<p class="hero-focus flex items-center gap-2 mt-6 font-mono text-xs text-slate-500">
					<span class="focus-dot w-2 h-2 rounded-full bg-blue-400 animate-pulse" aria-hidden="true"></span>
					Current focus: multi-agent systems, LLM evaluation & applied research
				</p>
			</div>

			<div class="hero-visual md:col-span-5 relative reveal" aria-hidden="true">
				<svg class="w-full h-auto mx-auto" viewBox="0 0 460 420" fill="none" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<linearGradient id="edgeFade" x1="0" y1="0" x2="460" y2="420" gradientUnits="userSpaceOnUse">
							<stop stop-color="#4cc2ff" stop-opacity="0.7"/>
							<stop offset="1" stop-color="#8b7cf6" stop-opacity="0.35"/>
						</linearGradient>
					</defs>
					<g stroke="url(#edgeFade)" stroke-width="1.4">
						<path d="M90 90 L230 60"/>
						<path d="M90 90 L150 210"/>
						<path d="M230 60 L360 120"/>
						<path d="M150 210 L230 60"/>
						<path d="M150 210 L300 260"/>
						<path d="M360 120 L300 260"/>
						<path d="M300 260 L390 340"/>
						<path d="M150 210 L120 340"/>
						<path d="M120 340 L300 260"/>
						<path d="M360 120 L420 230"/>
						<path d="M420 230 L390 340"/>
					</g>
					<g>
						<circle cx="90" cy="90" r="7" fill="#4cc2ff"/>
						<circle cx="230" cy="60" r="5" fill="#0a0b0f" stroke="#4cc2ff" stroke-width="2"/>
						<circle cx="360" cy="120" r="8" fill="#8b7cf6"/>
						<circle cx="150" cy="210" r="5" fill="#0a0b0f" stroke="#4cc2ff" stroke-width="2"/>
						<circle cx="300" cy="260" r="7" fill="#4cc2ff"/>
						<circle cx="420" cy="230" r="4.5" fill="#0a0b0f" stroke="#8b7cf6" stroke-width="2"/>
						<circle cx="120" cy="340" r="6" fill="#0a0b0f" stroke="#4cc2ff" stroke-width="2"/>
						<circle cx="390" cy="340" r="7" fill="#8b7cf6"/>
					</g>
					<g transform="translate(346 300)">
						<rect x="0" y="0" width="88" height="30" rx="8" fill="#12141b" stroke="rgba(148, 163, 184, 0.28)"/>
						<path d="M12 15.5 17 20.5 27 10.5" stroke="#4cc2ff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
						<text x="35" y="19.5" font-family="JetBrains Mono, monospace" font-size="11" fill="#a3abbd">verified</text>
					</g>
				</svg>
			</div>
		</div>
	</div>
</section>

<style>
	.animate-pulse {
		animation: pulse 2.4s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
	}
	@keyframes pulse {
		0% { box-shadow: 0 0 0 0 rgba(76, 194, 255, 0.5); }
		70% { box-shadow: 0 0 0 9px transparent; }
		100% { box-shadow: 0 0 0 0 transparent; }
	}
	.js .reveal {
		opacity: 0;
		transform: translateY(16px);
		transition: opacity 0.6s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
	}
	.js .reveal.is-visible {
		opacity: 1;
		transform: none;
	}
</style>